# Build output. Around 700 MB, and none of it is worth carrying: build.rs
# recompiles kernels/*.cu into the CUDA static library on every build, so a
# checked-in copy would go stale against the .cu sources it came from.
/target

# Editor and OS scratch.
.vs/
.idea/
*.swp
Thumbs.db
desktop.ini
# A second, CUDA-free build directory used for quick type checks.
/target-check

# Measurement scripts and raw output: kept locally, not published (the
# README carries the results).
/benchmarks

# Tracking and monitoring files (notes, progress logs, profiles, scratch
# scripts): local only, never committed. See AGENTS.md §13.
/local/
*.local.*
*.nsys-rep
*.ncu-rep
*.sqlite
